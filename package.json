{
  "name": "hoppo-san",
  "version": "1.0.0",
  "private": true,
  "description": "ほっぽさん — 住宅購入・ライフプラン統合アプリ",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.engine.json && tsc -p tsconfig.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "node --test e2e/ui.test.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "tsx": "4.23.12",
    "typescript": "6.0.3"
  }
}
